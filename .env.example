# Set credentials only on your own machine.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_STREAM_ENABLED=false
OPENAI_API_KEY=
# Optional news feeds: comma-separated RSS/Atom URLs selected by you.
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=300
# Choose a model that supports Responses API structured output.
OPENAI_MODEL=
# Optional local Drive CLI OAuth token; not required for normal server startup.
GOOGLE_DRIVE_ACCESS_TOKEN=
