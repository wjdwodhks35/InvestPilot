# Set credentials only on your own machine.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_STREAM_ENABLED=false
OPENAI_API_KEY=
# Optional news feeds: comma-separated RSS/Atom URLs selected by you.
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=300
# Choose a model that supports Responses API structured output.
OPENAI_MODEL=
# Optional local Drive CLI OAuth token; not required for normal server startup.
GOOGLE_DRIVE_ACCESS_TOKEN=
# Local free LLM for isolated AI paper experiments (never real orders).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Single-owner login. Keep enabled for any external deployment.
INVESTPILOT_AUTH_ENABLED=true
INVESTPILOT_AUTH_DB=data/auth.db
# false ONLY for HTTP loopback development; true for HTTPS deployments.
INVESTPILOT_AUTH_SECURE_COOKIE=true
# Set to the exact public HTTPS origin in production, without a trailing path.
INVESTPILOT_PUBLIC_ORIGIN=
# Optional persistent external PostgreSQL. Keep URL secret; TLS required in cloud.
INVESTPILOT_DATABASE_URL=
# Render free deployment requires postgres; blank means local SQLite development.
INVESTPILOT_STORAGE_MODE=

# Stable Fernet key for encrypted connection settings. Keep out of Git.
INVESTPILOT_SETTINGS_KEY=
